<script>
const INTRO = "Hi, I'm Likhith Rudresh, a quality, process and continuous improvement engineer based in Gothenburg, with an MSc in Quality and Operations Management from Chalmers and a Six Sigma Black Belt. I work on quality in regulated manufacturing. At Cepheid, I used DMAIC to cut a line's lead time by 56 percent, and 8D-based root-cause validation with an APQP-aligned, PPAP-style checklist to secure sign-off on the new process. At RISE, my FMEA-based framework was adopted by engineering teams. I'm looking for roles in quality, process or manufacturing engineering. Ask me anything below.";

const QA = [
  {q:"Why quality and process engineering?", k:["why","motivat","interest","this role","excited","passion"],
   a:"I like problems that can be measured and solved for good. Quality and process engineering lets me find the real root cause, rank the risks, fix them with the team and lock the gains into clear standards and KPIs. That's where I've had my best results, at Cepheid, RISE and Thermax."},
  {q:"What's your biggest result?", k:["result","achievement","proud","impact","biggest"],
   a:"At Cepheid, a regulated manufacturing line's 20.5-week lead time was limiting throughput. Using DMAIC tools like value stream mapping, cycle-time analysis and OEE monitoring, we brought it down to 9 weeks, a 56% cut. Replacing ad hoc knowledge with SOPs and KPI dashboards also cut the team's manual workload by 67%."},
  {q:"Do you have APQP or PPAP experience?", k:["apqp","ppap","sign-off","signoff","approval","launch","documentation"],
   a:"Yes, from a regulated manufacturing setting. At Cepheid, the redesigned process needed formal sign-off before going live. I ran 8D-based root-cause validation and an APQP-aligned, PPAP-style checklist, which gave stakeholders the documented evidence to approve it before the new SOPs rolled out."},
  {q:"How do you investigate a quality issue?", k:["investigat","problem","quality issue","root cause","rca","8d","defect","approach"],
   a:"I start by defining the issue with data, then contain it. Next I find and verify the real root cause with 8D or DMAIC tools, rank the risks with FMEA and agree corrective actions with the people who do the work. Finally, I document lessons learned so the issue doesn't come back. At Thermax, I did this on the shop floor in line with ISO 9001 and EHS."},
  {q:"How do you handle customer deviations?", k:["customer","deviation","complaint","nonconform","supplier"],
   a:"Structured and transparent. I confirm the deviation against the requirement, contain it, run a root-cause investigation with 8D and follow through on corrective actions and lessons learned. At Thermax, I built dashboards that tracked performance against quality and customer requirements, so gaps were visible early."},
  {q:"Have you worked with FMEA?", k:["fmea","risk","rpn","failure mode"],
   a:"Yes. In my master thesis at RISE, I ranked 6 failure modes by RPN and turned them into a prioritised action plan. Engineering teams adopted the resulting framework as their standard way to triage recurring quality risks."},
  {q:"What tools do you use?", k:["tool","software","power bi","excel","python","sap","jmp","cad","nx"],
   a:"Power BI and advanced Excel for KPI dashboards, Python and JMP for statistical analysis, SAP ERP, and CAD in Siemens NX and Solid Edge."},
  {q:"Can you work cross-functionally?", k:["team","cross","stakeholder","coach","lead","collaborat","communicat"],
   a:"Yes. At Cepheid, I trained and coached a cross-functional team on Lean tools. At RISE, I guided engineering stakeholders through 5 Stage-Gate milestones. As a volunteer at Chalmers, I coordinated teams onboarding over 1,000 international students."},
  {q:"Do you speak Swedish?", k:["swedish","svenska","language","english"],
   a:"My English is advanced and my Swedish is elementary. I'm actively improving my Swedish while living and working in Gothenburg."},
  {q:"How can I reach you?", k:["contact","email","phone","reach","call","interview","available"],
   a:"Email rlikhith02@gmail.com or call +46 727 727 661. You can also find me on LinkedIn at linkedin.com/in/likhithrudresh. I'd be glad to talk."}
];
const FALLBACK = "Good question! I'd rather answer that one properly in person. Email me at rlikhith02@gmail.com or call +46 727 727 661 and let's talk.";

const $ = id => document.getElementById(id);
const AUDIO = {"intro": "data:audio/mpeg;base64,", "fallback": "data:audio/mpeg;base64,", "qa:0": "data:audio/mpeg;base64,", "qa:1": "data:audio/mpeg;base64,", "qa:2": "data:audio/mpeg;base64,", "qa:3": "data:audio/mpeg;base64,", "qa:4": "data:audio/mpeg;base64,", "qa:5": "data:audio/mpeg;base64,", "qa:6": "data:audio/mpeg;base64,", "qa:7": "data:audio/mpeg;base64,", "qa:8": "data:audio/mpeg;base64,", "qa:9": "data:audio/mpeg;base64,"};

/* ---------- captions ---------- */
let words = [], starts = [];
function renderCaption(text){
  const c = $("caption"); c.innerHTML = ""; words = []; starts = []; let i = 0;
  text.split(" ").forEach(w=>{ const s=document.createElement("span"); s.className="w"; s.textContent=w+" "; c.appendChild(s); words.push(s); starts.push(i); i+=w.length+1; });
}
function highlight(n){
  words.forEach((w,j)=>{ w.classList.toggle("on", j<n); w.classList.toggle("now", j===n); });
  const now = words[n]; if(now){ const c=$("caption"); const t=now.offsetTop - c.offsetTop - 30; if(Math.abs(c.scrollTop - t) > 20) c.scrollTop = t; }
  $("prog").style.width = (words.length ? Math.min(100, Math.max(0,n)/words.length*100) : 0) + "%";
}
function wordAt(ci){ let i=0; while(i+1<starts.length && starts[i+1]<=ci) i++; return i; }

/* ---------- voice: one standard British male recording, the same on every device ---------- */
const synth = window.speechSynthesis;
let cur=null, raf=null, timer=null;
function voices(){ try{ return synth ? synth.getVoices() : []; }catch(e){ return []; } }
function daniel(){ return voices().find(v=>/daniel/i.test(v.name) && /^en/i.test(v.lang)); }
if(synth){ try{ synth.getVoices(); synth.addEventListener && synth.addEventListener("voiceschanged", ()=>{}); }catch(e){} }

function setSpeaking(on){
  $("hero").classList.toggle("speaking", on);
  $("playIcon").innerHTML = on ? '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>' : '<path d="M8 5.5v13l11-6.5z"/>';
  $("playBtn").setAttribute("aria-label", on ? "Stop intro" : "Play my intro");
}
function stopAll(){
  try{ synth && synth.cancel(); }catch(e){}
  try{ if(cur){ cur.pause(); cur=null; } }catch(e){}
  cancelAnimationFrame(raf); clearInterval(timer); setSpeaking(false);
}
function karaoke(){ let i=0; clearInterval(timer); timer=setInterval(()=>{ highlight(i++); if(i>words.length){ clearInterval(timer); setSpeaking(false);} },330); }

function play(key, text, captions){
  stopAll();
  if(captions){ renderCaption(text); highlight(-1); }
  setSpeaking(true);
  if(!AUDIO[key]){ if(captions) karaoke(); else setSpeaking(false); return; }
  cur = new Audio(AUDIO[key]);
  const total = text.length;
  const tick = ()=>{ if(!cur) return; if(captions && cur.duration) highlight(wordAt(Math.floor(cur.currentTime/cur.duration*total))); raf=requestAnimationFrame(tick); };
  cur.onended = ()=>{ if(captions) highlight(words.length); cancelAnimationFrame(raf); cur=null; setSpeaking(false); };
  cur.play().then(tick).catch(()=>{ cur=null; if(captions) karaoke(); else setSpeaking(false); });
}

$("playBtn").addEventListener("click", ()=>{ if($("hero").classList.contains("speaking")) return stopAll(); play("intro", INTRO, true); });
$("stopBtn").addEventListener("click", stopAll);
$("readBtn").addEventListener("click", ()=>{ stopAll(); highlight(words.length); $("prog").style.width="100%"; });

/* ---------- Q&A ---------- */
const photo = $("me").src;
function addAnswer(question, answer, key){
  const m = document.createElement("div"); m.className="msg";
  m.innerHTML = '<img alt=""><div class="bubble"><div class="q"></div><p></p><button class="hear">▶ Hear my answer</button></div>';
  m.querySelector("img").src = photo;
  m.querySelector(".q").textContent = question;
  m.querySelector("p").textContent = answer;
  m.querySelector(".hear").addEventListener("click", ()=>play(key, answer, false));
  $("thread").prepend(m); $("thread").scrollTop = 0;
}
QA.forEach((item,i)=>{
  const b=document.createElement("button"); b.className="chip"; b.textContent=item.q;
  b.addEventListener("click", ()=>{ document.querySelectorAll(".chip").forEach(c=>c.classList.remove("active")); b.classList.add("active"); addAnswer(item.q, item.a, "qa:"+i); });
  $("chips").appendChild(b);
});
$("askForm").addEventListener("submit", e=>{
  e.preventDefault(); const q=$("askInput").value.trim(); if(!q) return;
  const low=q.toLowerCase(); let best=-1, score=0;
  QA.forEach((it,i)=>{ const s=it.k.reduce((n,k)=>n+(low.includes(k)?k.length:0),0); if(s>score){score=s;best=i;} });
  addAnswer(q, best>=0 ? QA[best].a : FALLBACK, best>=0 ? "qa:"+best : "fallback");
  $("askInput").value="";
});

renderCaption(INTRO);
addAnswer(QA[0].q, QA[0].a, "qa:0");
</script>
