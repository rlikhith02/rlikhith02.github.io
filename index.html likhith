<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Likhith Rudresh – Quality, Process &amp; CI Engineer</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#0b1324; --bg2:#111c35; --panel:rgba(255,255,255,.05); --stroke:rgba(255,255,255,.10);
    --text:#eef2fa; --muted:#9fabc4; --gold:#d8b14a; --gold2:#f2d88a; --teal:#4fd1c5;
    --paper:#f6f3ee; --ink:#18202f; --line:#e7e0d6;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--paper);line-height:1.55;-webkit-font-smoothing:antialiased}
  a{color:inherit}
  .wrap{max-width:1120px;margin:0 auto;padding:0 22px}
  .serif{font-family:Fraunces,Georgia,serif}

  /* ---------- HERO ---------- */
  .hero{position:relative;color:var(--text);background:var(--bg);overflow:hidden;padding:26px 0 70px}
  .hero::before{content:"";position:absolute;inset:0;
    background:
      radial-gradient(700px 420px at 85% 10%, rgba(216,177,74,.22), transparent 60%),
      radial-gradient(600px 500px at 0% 100%, rgba(79,209,197,.14), transparent 60%),
      linear-gradient(180deg,var(--bg) 0%, var(--bg2) 100%);}
  .hero::after{content:"";position:absolute;inset:0;opacity:.07;
    background-image:linear-gradient(rgba(255,255,255,.6) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.6) 1px,transparent 1px);
    background-size:48px 48px;mask-image:radial-gradient(ellipse at 70% 30%,#000 10%,transparent 70%)}
  .hero > *{position:relative;z-index:1}
  .topbar{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:44px;font-size:13px;color:var(--muted)}
  .brand{display:flex;align-items:center;gap:10px;color:var(--text);font-weight:600;letter-spacing:.02em}
  .mono{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:linear-gradient(135deg,var(--gold),#a8862c);color:#1a1405;font:700 14px Inter}
  .applying{border:1px solid var(--stroke);background:var(--panel);padding:7px 12px;border-radius:999px;backdrop-filter:blur(6px)}
  .applying b{color:var(--gold2);font-weight:600}

  .hero-grid{display:grid;grid-template-columns:1.15fr .85fr;gap:56px;align-items:center}
  .kicker{display:inline-flex;align-items:center;gap:8px;font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--gold2)}
  .kicker i{width:28px;height:1px;background:var(--gold)}
  h1{font-family:Fraunces,Georgia,serif;font-weight:700;font-size:clamp(40px,6vw,72px);line-height:1;margin:16px 0 14px;letter-spacing:-.01em}
  h1 em{font-style:italic;font-weight:500;color:var(--gold2)}
  .role{font-size:clamp(17px,2vw,21px);color:#d5dcec;margin:0 0 22px;max-width:560px}
  .pills{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:26px}
  .pill{font-size:12.5px;padding:6px 11px;border-radius:999px;border:1px solid var(--stroke);background:var(--panel);color:#dbe2f0}
  .pill.g{border-color:rgba(216,177,74,.45);color:var(--gold2)}

  /* player */
  .player{border:1px solid var(--stroke);background:rgba(10,18,36,.55);backdrop-filter:blur(10px);border-radius:18px;padding:16px 18px;max-width:600px}
  .player-top{display:flex;align-items:center;gap:14px}
  .pbtn{flex:none;width:58px;height:58px;border-radius:50%;border:none;cursor:pointer;display:grid;place-items:center;
    background:linear-gradient(135deg,var(--gold2),var(--gold));color:#1a1405;box-shadow:0 0 0 0 rgba(216,177,74,.6);animation:pulse 2.2s infinite}
  .pbtn svg{width:24px;height:24px}
  .pbtn:focus-visible{outline:3px solid #fff;outline-offset:3px}
  .speaking .pbtn{animation:none}
  @keyframes pulse{70%{box-shadow:0 0 0 18px rgba(216,177,74,0)}100%{box-shadow:0 0 0 0 rgba(216,177,74,0)}}
  .ptitle{font-weight:600;font-size:15px}
  .psub{font-size:12.5px;color:var(--muted)}
  .bars{margin-left:auto;display:flex;gap:3px;align-items:center;height:26px}
  .bars span{width:3px;height:6px;border-radius:2px;background:var(--gold)}
  .speaking .bars span{animation:bar 1s ease-in-out infinite}
  .bars span:nth-child(2n){animation-delay:.15s}.bars span:nth-child(3n){animation-delay:.3s}.bars span:nth-child(5n){animation-delay:.45s}
  @keyframes bar{50%{height:24px}}
  .progress{height:3px;background:rgba(255,255,255,.1);border-radius:3px;margin:14px 0 10px;overflow:hidden}
  .progress div{height:100%;width:0;background:linear-gradient(90deg,var(--gold),var(--teal));transition:width .2s linear}
  .caption{margin:0;font-size:15px;line-height:1.6;max-height:100px;overflow:auto}
  .caption .w{color:#6f7b96;transition:color .12s}
  .caption .w.on{color:#e7ecf6}
  .caption .w.now{color:var(--gold2)}
  .pfoot{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-top:10px;font-size:11.5px;color:#8592ad;flex-wrap:wrap}
  .ctl{font:500 12px Inter;border:1px solid var(--stroke);background:transparent;color:#dbe2f0;border-radius:999px;padding:5px 11px;cursor:pointer}
  .ctl:hover{background:rgba(255,255,255,.08)}

  /* portrait */
  .portrait{position:relative;justify-self:center;width:min(380px,100%)}
  .frame{position:relative;border-radius:28px;overflow:hidden;aspect-ratio:4/5;box-shadow:0 30px 80px rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.12)}
  .frame img{width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.01)}
  .frame::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 55%,rgba(11,19,36,.75))}
  .halo{position:absolute;inset:-14px;border-radius:36px;border:1.5px solid rgba(216,177,74,.0);transition:border-color .3s}
  .speaking .halo{border-color:rgba(216,177,74,.75);animation:halo 1.8s ease-in-out infinite}
  @keyframes halo{50%{box-shadow:0 0 0 10px rgba(216,177,74,.10)}}
  .badge{position:absolute;left:-26px;bottom:34px;background:#fff;color:var(--ink);border-radius:16px;padding:12px 14px;box-shadow:0 18px 40px rgba(0,0,0,.35);display:flex;gap:10px;align-items:center}
  .badge b{font-family:Fraunces,serif;font-size:26px;line-height:1;color:#a8862c}
  .badge span{font-size:12px;line-height:1.3;color:#4b5468}
  .badge2{position:absolute;right:-18px;top:30px;background:rgba(11,19,36,.85);border:1px solid var(--stroke);color:var(--text);border-radius:14px;padding:9px 12px;font-size:12px;backdrop-filter:blur(6px)}
  .badge2 b{color:var(--gold2)}
  .name-on-photo{position:absolute;left:18px;bottom:16px;z-index:2;color:#fff;font-size:13px;opacity:.9}

  /* ---------- SECTIONS ---------- */
  section{padding:70px 0 0}
  .sh{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:26px;flex-wrap:wrap}
  .eyebrow{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#a8862c;font-weight:600}
  h2{font-family:Fraunces,Georgia,serif;font-size:clamp(28px,3.4vw,40px);margin:6px 0 0;line-height:1.1}
  .lead{color:#5b6477;max-width:520px;margin:0}

  .ach{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
  .tile{background:#fff;border:1px solid var(--line);border-radius:20px;padding:22px;position:relative;overflow:hidden;transition:transform .2s,box-shadow .2s}
  .tile:hover{transform:translateY(-3px);box-shadow:0 14px 34px rgba(24,32,47,.08)}
  .tile::before{content:"";position:absolute;inset:0 0 auto 0;height:4px;background:linear-gradient(90deg,var(--gold),var(--teal))}
  .tile .big{font-family:Fraunces,serif;font-size:44px;line-height:1;color:var(--ink);font-weight:700}
  .tile .big small{font-size:22px}
  .tile h3{font-size:15px;margin:10px 0 6px}
  .tile p{font-size:13.5px;color:#5b6477;margin:0}
  .tile .ico{font-family:Fraunces,serif;font-size:30px;line-height:1;color:#a8862c;font-weight:700}

  /* Q&A */
  .ask{display:grid;grid-template-columns:.9fr 1.1fr;gap:22px}
  .ask > *, .xp > *, .hero-grid > *{min-width:0}
  .askL{background:var(--bg);color:var(--text);border-radius:24px;padding:26px;position:relative;overflow:hidden}
  .askL::before{content:"";position:absolute;inset:auto -30% -40% auto;width:340px;height:340px;border-radius:50%;background:radial-gradient(circle,rgba(216,177,74,.22),transparent 65%)}
  .askL > *{position:relative}
  .askL h3{font-family:Fraunces,serif;font-size:24px;margin:0 0 6px}
  .askL p{color:var(--muted);font-size:14px;margin:0 0 16px}
  .chips{display:flex;flex-direction:column;gap:8px}
  .chip{text-align:left;font:500 14px Inter;border:1px solid var(--stroke);background:var(--panel);color:#e3e8f3;border-radius:12px;padding:11px 14px;cursor:pointer;transition:all .15s;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .chip::after{content:"→";color:var(--gold2);opacity:.6}
  .chip:hover,.chip.active{background:rgba(216,177,74,.14);border-color:rgba(216,177,74,.5)}
  .askR{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px;display:flex;flex-direction:column;min-height:520px}
  .ask-form{display:flex;gap:8px;margin-bottom:16px}
  .ask-form input{flex:1;font:15px Inter;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:var(--paper)}
  .ask-form input:focus{outline:2px solid var(--gold);border-color:transparent;background:#fff}
  .ask-form button{font:600 14px Inter;border:none;background:var(--bg);color:#fff;border-radius:12px;padding:0 18px;cursor:pointer}
  .thread{display:flex;flex-direction:column;gap:14px;overflow:auto;max-height:560px;padding-right:4px}
  .msg{display:flex;gap:12px;align-items:flex-start;animation:in .35s ease}
  @keyframes in{from{opacity:0;transform:translateY(6px)}}
  .msg img{width:40px;height:40px;border-radius:50%;object-fit:cover;flex:none;border:2px solid var(--gold2)}
  .bubble{background:var(--paper);border:1px solid var(--line);border-radius:4px 16px 16px 16px;padding:13px 15px}
  .q{font-weight:600;font-size:13.5px;color:#a8862c;margin-bottom:4px}
  .bubble p{margin:0;font-size:14.5px}
  .hear{margin-top:9px;font:600 12px Inter;background:var(--bg);color:#fff;border:none;border-radius:999px;padding:5px 11px;cursor:pointer}

  /* experience */
  .xp{display:grid;grid-template-columns:1.35fr .65fr;gap:22px}
  .timeline{background:#fff;border:1px solid var(--line);border-radius:24px;padding:26px 26px 10px}
  .job{position:relative;padding:0 0 22px 26px;border-left:2px solid var(--line);margin-left:6px}
  .job:last-child{border-left-color:transparent}
  .job::before{content:"";position:absolute;left:-8px;top:2px;width:14px;height:14px;border-radius:50%;background:#fff;border:3px solid var(--gold)}
  .job h3{margin:0;font-size:16.5px}
  .job .where{font-size:13px;color:#6b7387;margin:2px 0 10px}
  .job ul{margin:0;padding-left:18px;font-size:14.5px}
  .job li{margin:5px 0}
  .job li b{color:var(--ink)}
  .side{display:flex;flex-direction:column;gap:16px}
  .box{background:#fff;border:1px solid var(--line);border-radius:20px;padding:20px}
  .box h4{margin:0 0 10px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#6b7387}
  .tags{display:flex;flex-wrap:wrap;gap:6px}
  .tag{font-size:12.5px;background:#f4ecd6;color:#5d4a12;border-radius:7px;padding:4px 9px}
  .tag.d{background:#e9eef8;color:#26324d}
  .edu p{margin:0 0 10px;font-size:14px}
  .edu p:last-child{margin:0}
  .muted{color:#6b7387;font-size:13px}

  /* CTA */
  .cta{margin:70px 0 0;background:var(--bg);color:var(--text);border-radius:28px;padding:44px;position:relative;overflow:hidden;display:grid;grid-template-columns:1fr auto;gap:24px;align-items:center}
  .cta::before{content:"";position:absolute;inset:0;background:radial-gradient(500px 300px at 90% 0%,rgba(216,177,74,.25),transparent 60%)}
  .cta > *{position:relative}
  .cta h2{color:#fff;margin:0 0 8px}
  .cta p{color:var(--muted);margin:0}
  .cbtns{display:flex;flex-direction:column;gap:10px;min-width:260px}
  .cbtn{display:block;text-align:center;text-decoration:none;font-weight:600;padding:12px 18px;border-radius:999px;font-size:14px}
  .cbtn.p{background:linear-gradient(135deg,var(--gold2),var(--gold));color:#1a1405}
  .cbtn.s{border:1px solid var(--stroke);color:#fff}
  footer{padding:30px 0 50px;text-align:center;font-size:12.5px;color:#7a8296}

  @media (max-width:900px){
    .hero-grid{grid-template-columns:1fr;gap:36px}
    .portrait{order:-1;width:min(300px,78vw)}
    .badge{left:-10px}.badge2{right:-6px}
    .ach{grid-template-columns:1fr 1fr}
    .ask,.xp{grid-template-columns:1fr}
    .askR{min-height:0}
    .cta{grid-template-columns:1fr;padding:30px}
    .topbar .applying{display:none}
  }
  @media (max-width:520px){ .ach{grid-template-columns:1fr} .tile .big{font-size:38px} }
  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>

<header class="hero" id="hero">
  <div class="wrap">
    <div class="topbar">
      <div class="brand"><div class="mono">LR</div>Likhith Rudresh</div>
      <div class="applying">Open to <b>quality, process &amp; CI engineering</b> roles</div>
    </div>

    <div class="hero-grid">
      <div>
        <div class="kicker"><i></i>Meet AI Me · press play</div>
        <h1>Quality you can <em>measure.</em></h1>
        <p class="role">I'm Likhith, a <b>Quality, Process &amp; Continuous Improvement Engineer</b> in Gothenburg. I find root causes, rank risks and turn process redesigns into audit-ready standards.</p>
        <div class="pills">
          <span class="pill g">Six Sigma Black Belt</span>
          <span class="pill">MSc Quality &amp; Operations · Chalmers</span>
          <span class="pill">DMAIC · 8D · FMEA · APQP/PPAP</span>
          <span class="pill">📍 Gothenburg</span>
        </div>

        <div class="player">
          <div class="player-top">
            <button class="pbtn" id="playBtn" aria-label="Play my intro">
              <svg id="playIcon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"/></svg>
            </button>
            <div>
              <div class="ptitle">Hear my 45-second intro</div>
              <div class="psub">A quick hello from me</div>
            </div>
            <div class="bars"><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
          </div>
          <div class="progress"><div id="prog"></div></div>
          <p class="caption" id="caption"></p>
          <div class="pfoot">
            <span>🔊 Written and approved by Likhith, read by an AI British male voice.</span>
            <span><button class="ctl" id="stopBtn">■ Stop</button> <button class="ctl" id="readBtn">Read all</button></span>
          </div>
        </div>
      </div>

      <div class="portrait">
        <div class="halo"></div>
        <div class="frame"><img id="me" src="data:image/jpeg;base64," alt="Likhith Rudresh"></div>
        <div class="badge"><b>56%</b><span>lead-time cut<br>at Cepheid</span></div>
      </div>
    </div>
  </div>
</header>

<main class="wrap">

  <section id="results">
    <div class="sh">
      <div><div class="eyebrow">Key achievements</div><h2>Results, not just responsibilities</h2></div>
      <p class="lead">Four outcomes from regulated manufacturing and applied research.</p>
    </div>
    <div class="ach">
      <div class="tile"><div class="big">56<small>%</small></div><h3>Lead-time reduction</h3><p>DMAIC redesign (VSM, cycle time, OEE) on a regulated Cepheid line: 20.5 → 9 weeks.</p></div>
      <div class="tile"><div class="big">67<small>%</small></div><h3>Team workload reduction</h3><p>Standardised the new process into trained SOPs and Power BI/Excel KPI dashboards.</p></div>
      <div class="tile"><div class="ico">FMEA</div><h3>Governance framework adopted</h3><p>6 RPN-ranked failure modes became a prioritised action plan at RISE. Engineering teams adopted it to triage recurring quality risks.</p></div>
      <div class="tile"><div class="ico">8D ✓</div><h3>APQP/PPAP-style sign-off</h3><p>8D-based root-cause validation gave stakeholders the evidence to approve a redesigned process before new SOPs went live.</p></div>
    </div>
  </section>

  <section id="ask">
    <div class="sh">
      <div><div class="eyebrow">Interactive</div><h2>Ask me anything</h2></div>
      <p class="lead">Click a question or type your own. Every answer is based on my real experience, and you can hear each one.</p>
    </div>
    <div class="ask">
      <div class="askL">
        <h3>Questions recruiters ask</h3>
        <p>Tap one to see and hear my answer.</p>
        <div class="chips" id="chips"></div>
      </div>
      <div class="askR">
        <form class="ask-form" id="askForm">
          <input id="askInput" placeholder="e.g. Do you know PPAP?" autocomplete="off" aria-label="Your question">
          <button type="submit">Ask</button>
        </form>
        <div class="thread" id="thread"></div>
      </div>
    </div>
  </section>

  <section id="experience">
    <div class="sh">
      <div><div class="eyebrow">Experience</div><h2>Where I've done it</h2></div>
    </div>
    <div class="xp">
      <div class="timeline">
        <div class="job">
          <h3>Student Researcher (Master Thesis)</h3>
          <div class="where">RISE Research Institutes of Sweden · Gothenburg · Jan–Jul 2026</div>
          <ul>
            <li>Structured a 3-phase, 6-month applied research programme across <b>5 Stage-Gate milestones</b>, giving stakeholders a decision-ready output at each stage.</li>
            <li><b>FMEA-based risk analysis (RPN-ranked)</b> of 6 failure modes, turned into prioritised actions and a CI governance framework adopted by engineering teams.</li>
          </ul>
        </div>
        <div class="job">
          <h3>Six Sigma DMAIC Lean Process Development · Student Intern</h3>
          <div class="where">Cepheid AB (student project) · Stockholm · Jan–Aug 2025</div>
          <ul>
            <li>DMAIC on a regulated manufacturing line (VSM, cycle time, waste elimination, OEE): <b>lead time −56%</b>, from 20.5 to 9 weeks.</li>
            <li>Ran <b>8D-based root-cause validation</b> and an <b>APQP-aligned, PPAP-style checklist</b>, securing sign-off before the new SOPs rolled out.</li>
            <li>Trained and coached the cross-functional team on Lean tools, and built KPI dashboards and SOPs in Power BI/Excel: <b>workload −67%</b>.</li>
          </ul>
        </div>
        <div class="job">
          <h3>Manufacturing Quality and Process Intern</h3>
          <div class="where">Thermax Limited KEP · Bengaluru, India · Feb–Apr 2024</div>
          <ul>
            <li><b>Root-cause analysis</b> and production flow mapping, with corrective actions coordinated with manufacturing per <b>ISO 9001/EHS</b>.</li>
            <li>Built dashboards tracking KPIs against quality and customer requirements and documenting lessons learned. Management adopted the recommendations.</li>
          </ul>
        </div>
        <div class="job">
          <h3>Phadder Manager (Volunteer)</h3>
          <div class="where">CIRC, Chalmers University of Technology · Nov 2024–Dec 2025</div>
          <ul>
            <li>Coordinated volunteer teams to onboard <b>1,000+ international students</b> across 10+ parallel workstreams.</li>
          </ul>
        </div>
      </div>

      <div class="side">
        <div class="box">
          <h4>Product quality</h4>
          <div class="tags"><span class="tag">Technical problem-solving</span><span class="tag">Root cause analysis</span><span class="tag">Customer deviation handling</span><span class="tag">Quality issue investigation</span><span class="tag">8D</span><span class="tag">FMEA</span><span class="tag">ISO 9001</span></div>
        </div>
        <div class="box">
          <h4>Analysis &amp; improvement</h4>
          <div class="tags"><span class="tag">Six Sigma DMAIC</span><span class="tag">VSM</span><span class="tag">Statistical analysis</span><span class="tag">OEE</span><span class="tag">Cycle time</span><span class="tag">Lean tools</span><span class="tag">Process standardisation</span></div>
        </div>
        <div class="box">
          <h4>Tools</h4>
          <div class="tags"><span class="tag d">Power BI</span><span class="tag d">Excel (advanced)</span><span class="tag d">Python</span><span class="tag d">JMP</span><span class="tag d">SAP ERP</span><span class="tag d">Siemens NX</span><span class="tag d">Solid Edge</span><span class="tag d">MS Office</span></div>
        </div>
        <div class="box edu">
          <h4>Education</h4>
          <p><b>MSc Quality &amp; Operations Management</b><br><span class="muted">Chalmers University of Technology · 2024–2026</span></p>
          <p><b>BEng Mechanical Engineering</b><br><span class="muted">Global Academy of Technology, India · 2020–2024</span></p>
        </div>
        <div class="box edu">
          <h4>Certifications &amp; awards</h4>
          <p><b>Six Sigma Black Belt</b> <span class="muted">· Chalmers · 2026</span></p>
          <p><b>No. 1 of 40+</b>, Lean Development Game <span class="muted">· Chalmers · 2024</span></p>
          <p>Expert Project Management · Supply Chain Management · Basics of Python <span class="muted">· Infosys Springboard</span></p>
        </div>
        <div class="box edu">
          <h4>Languages</h4>
          <p>English: Advanced · Swedish: Elementary</p>
        </div>
      </div>
    </div>
  </section>

  <div class="cta">
    <div>
      <h2 class="serif">Let's talk.</h2>
